# Shared config for aisstatic.py, aisposition.py and aisposition_b.py.
# IMPORTANT: no inline comments after a value - the loader does not strip them.

PG_HOST=marineai2.cxwk8yige5f2.ap-southeast-5.rds.amazonaws.com
PG_PORT=5432
PG_USER=postgresadmin
PG_PASSWORD=changeme
PG_DATABASE=pnav

CH_HOST=56.69.44.39
CH_PORT=8123
CH_USER=default
CH_PSWD=changeme

# aisstatic.py only
CH_LOOKBACK_MINUTES=30
LOOP_SLEEP_SEC=100
IMO_CHECK_DIGIT=1

# aisposition.py and aisposition_b.py
POSITION_LOOP_SLEEP_SEC=2
WATERMARK_FILE=pnav_aisposition.txt
WATERMARK_FILE_B=pnav_aisposition_b.txt
# Catch-up chunk size when the resume watermark is older than the live lookback.
WINDOW_SECONDS=600
# Rolling live query window; also the lag at which catch-up stops and live begins.
LIVE_LOOKBACK_MINUTES=10
# Feed-health warning only (does not switch live/catch-up modes).
LIVE_MODE_THRESHOLD=700
ERROR_SLEEP_SEC=12
CHUNK_SIZE=2000
HEALTH_RETENTION_DAYS=30
HEALTH_PURGE_INTERVAL_HOURS=24
HEALTH_PURGE_CHUNK=10000
HEALTH_PURGE_MAX_SECONDS=60
# Last-known noise gates in aisposition.py (ITU + kinematics). Heading 511 is kept.
POSITION_MAX_IMPLIED_KNOTS=80
POSITION_MIN_JUMP_KM=1
POSITION_CH_ROWS_PER_MMSI=5
# Server-side guards so a blocked write fails fast and the cycle retries.
PG_STATEMENT_TIMEOUT_MS=30000
PG_LOCK_TIMEOUT_MS=5000
# Bounds how long a cycle waits on a ClickHouse that stopped answering.
CH_CONNECT_TIMEOUT_SEC=15
CH_SEND_RECEIVE_TIMEOUT_SEC=60
